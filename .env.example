# ZaK Trading View
# Local development placeholders only.
# Never put real secrets or credentials here.

APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000

# PostgreSQL
DATABASE_URL=
# Dedicated Alembic migration role; never reuse the application role.
MIGRATION_DATABASE_URL=

# Redis - optional until infrastructure is approved
REDIS_URL=

# Public market data only.
# Do not add Binance API keys, trading credentials,
# exchange secrets or real-order configuration.

# All secret values must be supplied through
# private local environment configuration.
# Auth0 OIDC — leave blank until the authentication deployment is configured.
# Supply real values only through private environment configuration.
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
AUTH0_CALLBACK_URL=
APP_PUBLIC_URL=

# Generate a unique 32-byte base64url key for each environment.
# Never reuse development keys in production.
OIDC_TRANSACTION_ENCRYPTION_KEYS=
OIDC_TRANSACTION_ACTIVE_KEY_ID=
# Local Next.js BFF -> FastAPI authentication.
# Disabled unless local development integration is explicitly enabled.
# Use a unique random secret of at least 32 characters.
# Never use this replayable local-only secret in production.
OIDC_INTERNAL_AUTH_MODE=
OIDC_INTERNAL_SERVICE_SECRET=
